# Base URL of the deployed API Gateway stage, e.g.
# https://abc123.execute-api.us-east-1.amazonaws.com/prod
# Leave unset to talk to the local Lambda shim on http://127.0.0.1:8000
VITE_API_BASE_URL=

# API Gateway WebSocket API URL, e.g.
# wss://abc123.execute-api.us-east-1.amazonaws.com/prod
# Leave unset to use the local hub on ws://127.0.0.1:8001
VITE_WS_URL=
